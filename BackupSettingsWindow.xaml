<Window x:Class="ResxBridge.BackupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Settings"
        Width="760"
        Height="920"
        MinWidth="620"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>

        <Style x:Key="SectionHeadingStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#203B56"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DescriptionStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PathTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ReadOnlyPathStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource PathTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#4B5563"/>
        </Style>

        <Style x:Key="DialogButtonStyle"
               TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryDialogButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#203B56"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#203B56"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="24,20">

            <StackPanel>

                <TextBlock Text="Backup Settings"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#203B56"/>

                <TextBlock
                    Text="Configure where ResX Bridge stores original resource files."
                    Style="{StaticResource DescriptionStyle}"
                    Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

        <!-- Scrollable settings content -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="24,20,24,20">

                <!-- Application defaults -->

                <TextBlock
                    Text="Application defaults"
                    Style="{StaticResource SectionHeadingStyle}"/>

                <TextBlock
                    Text="Default backup location"
                    Style="{StaticResource FieldLabelStyle}"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="DefaultBackupDirectoryTextBox"
                        Grid.Column="0"
                        Style="{StaticResource PathTextBoxStyle}"
                        TextChanged="SettingsChanged"/>

                    <Button
                        Grid.Column="1"
                        Content="Browse..."
                        Style="{StaticResource DialogButtonStyle}"
                        Margin="8,0,0,0"
                        Click="BrowseDefaultBackupDirectory_Click"/>

                </Grid>

                <DockPanel Margin="0,8,0,0">

                    <Button
                        DockPanel.Dock="Right"
                        Content="Use default location"
                        Padding="8,3"
                        Margin="12,0,0,0"
                        Click="ResetDefaultBackupDirectory_Click"/>

                    <TextBlock
                        Text="Used by projects without a custom backup location."
                        Style="{StaticResource DescriptionStyle}"
                        VerticalAlignment="Center"/>

                </DockPanel>

                <Separator Margin="0,20"/>

                <!-- Current project -->

                <StackPanel x:Name="ProjectSettingsPanel">

                    <TextBlock
                        Text="Current project"
                        Style="{StaticResource SectionHeadingStyle}"/>

                    <TextBlock
                        Text="Resource directory"
                        Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox
                        x:Name="ResourceDirectoryTextBox"
                        Style="{StaticResource ReadOnlyPathStyle}"
                        Margin="0,0,0,14"/>

                    <TextBlock
                        Text="Associated project file"
                        Style="{StaticResource FieldLabelStyle}"/>

                    <ComboBox
                        x:Name="ProjectFileComboBox"
                        MinHeight="34"
                        Padding="8,5"
                        VerticalContentAlignment="Center"
                        SelectionChanged="ProjectFileComboBox_SelectionChanged"/>

                    <TextBlock
                        x:Name="ProjectDetectionStatusTextBlock"
                        Style="{StaticResource DescriptionStyle}"
                        Margin="0,6,0,14"/>

                    <TextBlock
                        Text="Project name"
                        Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox
                        x:Name="ProjectNameTextBox"
                        Style="{StaticResource PathTextBoxStyle}"
                        TextChanged="SettingsChanged"/>

                    <TextBlock
                        Text="Confirm or change the suggested name used to organize your backups."
                        Style="{StaticResource DescriptionStyle}"
                        Margin="0,6,0,16"/>

                    <!-- Project-specific override -->

                    <CheckBox
                        x:Name="UseCustomBackupDirectoryCheckBox"
                        Content="Use a custom backup location for this project"
                        Checked="CustomBackupDirectory_Changed"
                        Unchecked="CustomBackupDirectory_Changed"
                        Margin="0,0,0,10"/>

                    <Grid
                        x:Name="CustomBackupDirectoryPanel"
                        Visibility="Collapsed">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="CustomBackupDirectoryTextBox"
                            Grid.Column="0"
                            Style="{StaticResource PathTextBoxStyle}"
                            TextChanged="SettingsChanged"/>

                        <Button
                            Grid.Column="1"
                            Content="Browse..."
                            Style="{StaticResource DialogButtonStyle}"
                            Margin="8,0,0,0"
                            Click="BrowseCustomBackupDirectory_Click"/>

                    </Grid>

                    <Separator Margin="0,20"/>

                    <!-- Effective backup destination -->

                    <TextBlock
                        Text="Effective project backup directory"
                        Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox
                        x:Name="EffectiveBackupDirectoryTextBox"
                        Style="{StaticResource ReadOnlyPathStyle}"
                        TextWrapping="Wrap"
                        MinHeight="48"/>

                    <TextBlock
                        Text="Each update creates a separate timestamped backup snapshot in this directory."
                        Style="{StaticResource DescriptionStyle}"
                        Margin="0,6,0,10"/>

                    <Button
                        x:Name="OpenBackupFolderButton"
                        Content="Open backup folder"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DialogButtonStyle}"
                        IsEnabled="False"
                        Click="OpenBackupFolder_Click"/>

                </StackPanel>

                <!-- No project selected -->

                <Border
                    x:Name="NoProjectPanel"
                    Visibility="Collapsed"
                    Background="#F3F4F6"
                    CornerRadius="4"
                    Padding="16">

                    <TextBlock
                        Text="Select a resource directory in the main window to configure project-specific backup settings."
                        Style="{StaticResource DescriptionStyle}"/>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- Footer -->

        <Border Grid.Row="2"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Background="#F8FAFC"
                Padding="24,14">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="ValidationMessageTextBlock"
                    Grid.Column="0"
                    Foreground="#B91C1C"
                    FontSize="12"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource DialogButtonStyle}"
                        Margin="0,0,8,0"/>

                    <Button
                        x:Name="SaveSettingsButton"
                        Content="Save Settings"
                        IsDefault="True"
                        Style="{StaticResource PrimaryDialogButtonStyle}"
                        Click="SaveSettings_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>
