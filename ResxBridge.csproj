<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<RootNamespace>ResxBridge</RootNamespace>
		<AssemblyName>ResxBridge</AssemblyName>
        <ApplicationIcon>Resources\Branding\ResxBridge.ico</ApplicationIcon>

		<Product>ResX Bridge</Product>
		<Title>ResX Bridge</Title>
        <Description>A lightweight utility for safely exchanging RESX translations through XLSX workbooks.</Description>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.0" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Resources\Branding\" />
	  <Folder Include="Resources\Screenshots\" />
	</ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Branding\ResxBridge.ico" />
        <Resource Include="Resources\Branding\ResxBridgeIcon.png" />
        <Resource Include="Resources\Branding\ResxBridgeLogo.png" />
    </ItemGroup>

</Project>
